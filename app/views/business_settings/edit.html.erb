<div
  class="
    max-w-3xl mx-auto space-y-8 animate-in fade-in slide-in-from-bottom-4
    duration-500
  "
>
  <header class="pb-6 border-b border-slate-200">
    <h1 class="text-2xl font-black text-slate-900 tracking-tight">Business Settings</h1>
    <p class="text-sm text-slate-500 mt-1 font-medium">Company details that appear on every invoice header and footer.</p>
  </header>

  <%= form_with(model: @business, url: business_settings_path, class: "space-y-8") do |f| %>
    <% if @business.errors.any? %>
      <div
        class="
          bg-rose-50 border border-rose-200 text-rose-800 px-6 py-4 rounded-xl text-sm
        "
      >
        <h2 class="font-bold uppercase tracking-wide mb-2"><%= pluralize(@business.errors.count, "error") %>
          prevented settings from being saved:</h2>
        <ul class="list-disc list-inside space-y-1">
          <% @business.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <%# ---- Company Info ---- %>
    <div
      class="
        bg-white rounded-2xl shadow-sm border border-slate-200 overflow-hidden
      "
    >
      <div
        class="
          p-6 border-b border-slate-100 bg-slate-50/50 flex items-center space-x-3
        "
      >
        <div
          class="
            w-10 h-10 bg-indigo-50 text-indigo-600 rounded-xl flex items-center
            justify-center
          "
        >
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"
            ></path></svg>
        </div>
        <div>
          <h2 class="text-base font-bold text-slate-900 uppercase tracking-tight">Company Information</h2>
          <p class="text-[10px] text-slate-400 font-bold uppercase tracking-widest">Global branding and contact info</p>
        </div>
      </div>

      <div class="p-4 sm:p-8 space-y-6">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <div class="space-y-2 md:col-span-2">
            <%= f.label :name,
                    "Company Name",
                    class:
                      "px-2 py-2 block text-[11px] font-bold text-slate-500 uppercase tracking-widest" %>
            <%= f.text_field :name,
                         required: true,
                         class:
                           "px-2 py-2 block w-full rounded-xl border-slate-200 text-slate-700 focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm shadow-sm" %>
          </div>

          <div class="space-y-2 md:col-span-2">
            <%= f.label :tagline,
                    class:
                      "block text-[11px] font-bold text-slate-500 uppercase tracking-widest" %>
            <%= f.text_field :tagline,
                         placeholder: "e.g. Premium Tourist Services",
                         class:
                           "px-2 py-2 block w-full rounded-xl border-slate-200 text-slate-700 focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm shadow-sm" %>
          </div>

          <div class="space-y-2 md:col-span-2">
            <%= f.label :address,
                    class:
                      "block text-[11px] font-bold text-slate-500 uppercase tracking-widest" %>
            <%= f.text_field :address,
                         placeholder: "Full business address",
                         class:
                           "px-2 py-2 block w-full rounded-xl border-slate-200 text-slate-700 focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm shadow-sm" %>
          </div>

          <div class="space-y-2">
            <%= f.label :registration_label,
                    class:
                      "block text-[11px] font-bold text-slate-500 uppercase tracking-widest" %>
            <%= f.text_field :registration_label,
                         placeholder: "e.g. Tax ID",
                         class:
                           "px-2 py-2 block w-full rounded-xl border-slate-200 text-slate-700 focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm shadow-sm" %>
          </div>

          <div class="space-y-2">
            <%= f.label :registration_number,
                    class:
                      "block text-[11px] font-bold text-slate-500 uppercase tracking-widest" %>
            <%= f.text_field :registration_number,
                         placeholder: "e.g. 123456-0",
                         class:
                           "px-2 py-2 block w-full rounded-xl border-slate-200 text-slate-700 focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm shadow-sm" %>
          </div>

          <div class="space-y-2">
            <%= f.label :phone,
                    class:
                      "block text-[11px] font-bold text-slate-500 uppercase tracking-widest" %>
            <%= f.text_field :phone,
                         class:
                           "px-2 py-2 block w-full rounded-xl border-slate-200 text-slate-700 focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm shadow-sm" %>
          </div>

          <div class="space-y-2">
            <%= f.label :email,
                    class:
                      "block text-[11px] font-bold text-slate-500 uppercase tracking-widest" %>
            <%= f.email_field :email,
                          class:
                            "px-2 py-2 block w-full rounded-xl border-slate-200 text-slate-700 focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm shadow-sm" %>
          </div>
        </div>
      </div>
    </div>

    <%# ---- Invoice Defaults ---- %>
    <div
      class="
        bg-white rounded-2xl shadow-sm border border-slate-200 overflow-hidden
      "
    >
      <div
        class="
          p-6 border-b border-slate-100 bg-slate-50/50 flex items-center space-x-3
        "
      >
        <div
          class="
            w-10 h-10 bg-emerald-50 text-emerald-600 rounded-xl flex items-center
            justify-center
          "
        >
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"
            ></path></svg>
        </div>
        <div>
          <h2 class="text-base font-bold text-slate-900 uppercase tracking-tight">Invoice Defaults</h2>
          <p class="text-[10px] text-slate-400 font-bold uppercase tracking-widest">Default terms and formatting</p>
        </div>
      </div>

      <div class="p-4 sm:p-8 space-y-6">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <div class="space-y-2">
            <%= f.label :currency,
                    class:
                      "block text-[11px] font-bold text-slate-500 uppercase tracking-widest" %>
            <%= f.text_field :currency,
                         placeholder: "USD",
                         class:
                           "px-2 py-2 block w-full rounded-xl border-slate-200 text-slate-700 focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm shadow-sm font-mono" %>
          </div>

          <div class="space-y-2">
            <%= f.label :payment_terms_days,
                    "Payment Terms (Days)",
                    class:
                      "block text-[11px] font-bold text-slate-500 uppercase tracking-widest" %>
            <%= f.number_field :payment_terms_days,
                           min: 0,
                           class:
                             "px-2 py-2 block w-full rounded-xl border-slate-200 text-slate-700 focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm shadow-sm font-mono" %>
          </div>

          <div class="space-y-2 md:col-span-2">
            <%= f.label :footer_note,
                    class:
                      "block text-[11px] font-bold text-slate-500 uppercase tracking-widest" %>
            <%= f.text_area :footer_note,
                        rows: 4,
                        placeholder:
                          "Texto que vai aparecer no final / rodapé de todo invoice",
                        class:
                          "px-2 py-2 block w-full rounded-xl border-slate-200 text-slate-700 focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm shadow-sm" %>
          </div>
        </div>
      </div>
    </div>

    <div
      class="
        flex items-center justify-end space-x-4 pt-4 border-t border-slate-100
      "
    >
      <%= link_to "Cancel",
      invoices_path,
      class: "text-sm font-bold text-slate-500 hover:text-slate-800 transition-colors" %>
      <%= f.submit "Save Settings",
               class:
                 "px-8 py-3 bg-indigo-600 hover:bg-indigo-700 text-white font-bold rounded-xl shadow-lg shadow-indigo-100 transition-all duration-200 cursor-pointer" %>
    </div>
  <% end %>
</div>
