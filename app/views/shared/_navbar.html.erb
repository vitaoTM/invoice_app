<% return unless Current.user %>
<nav class="bg-white border-b border-slate-100 sticky top-0 z-50">
  <div class="container mx-auto px-4 sm:px-6 h-16 flex items-center justify-between">
    <div class="flex items-center">
      <%= link_to root_path, class: "flex items-center space-x-2 group" do %>
        <%# <span class="text-2xl text-indigo-600 transition group-hover:scale-110"> %>
          <%= image_tag "logo.png", alt: "Loki Invoices Logo", height: "40", width: "80" %>
        <%# </span> %>
        <span class="font-bold text-lg text-slate-800 tracking-tight"><%= current_business.name %></span>
      <% end %>
    </div>

    <!-- Desktop Navigation -->
    <div class="hidden sm:flex items-center space-x-8">


        <%= link_to "Invoices",
        invoices_path,
        class:
          "font-medium text-sm #{controller_name == "invoices" ? "text-indigo-600" : "text-slate-500 hover:text-slate-800"}" %>

        <%= link_to "Clients",
        clients_path,
        class:
          "font-medium text-sm transition-colors duration-200 #{controller_name == "clients" ? "text-indigo-600" : "text-slate-500 hover:text-slate-800"}" %>

        <%= link_to "Settings",
        edit_business_settings_path,
        class:
          "font-medium text-sm transition-colors duration-200 #{controller_name == "business_settings" ? "text-indigo-600" : "text-slate-500 hover:text-slate-800"}" %>

        <%= button_to "Log out",
          session_path,
          method: :delete,
          class: "font-medium text-sm transition-colors duration-200 text-slate-500 hover:text-slate-800 bg-transparent border-0 p-0 cursor-pointer" %>
    </div>
  </div>
</nav>

<!-- Mobile Bottom Navigation -->
<div
  class="
sm:hidden fixed bottom-0 left-0 right-0 bg-white border-t border-slate-100
px-6 py-3 z-50 flex items-center justify-around shadow-[0_-4px_6px_-1px_rgba(0,0,0,0.05)]
"
>
  <%= link_to invoices_path, class: "flex flex-col items-center space-y-1" do %>
    <svg
      class="w-5 h-5 <%= controller_name == "invoices" ? "text-indigo-600" : "text-slate-400" %>"
      fill="none"
      stroke="currentColor"
      viewBox="0 0 24 24"
    ><path
        stroke-linecap="round"
        stroke-linejoin="round"
        stroke-width="2"
        d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"
      ></path></svg>
    <span
      class="text-[10px] font-bold uppercase tracking-widest <%= controller_name == "invoices" ? "text-indigo-600" : "text-slate-400" %>"
    >Invoices</span>
  <% end %>

  <%= link_to clients_path, class: "flex flex-col items-center space-y-1" do %>
    <svg
      class="w-5 h-5 <%= controller_name == "clients" ? "text-indigo-600" : "text-slate-400" %>"
      fill="none"
      stroke="currentColor"
      viewBox="0 0 24 24"
    ><path
        stroke-linecap="round"
        stroke-linejoin="round"
        stroke-width="2"
        d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 005.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"
      ></path></svg>
    <span
      class="text-[10px] font-bold uppercase tracking-widest <%= controller_name == "clients" ? "text-indigo-600" : "text-slate-400" %>"
    >Clients</span>
  <% end %>

  <%= link_to edit_business_settings_path, class: "flex flex-col items-center space-y-1" do %>
    <svg
      class="w-5 h-5 <%= controller_name == "business_settings" ? "text-indigo-600" : "text-slate-400" %>"
      fill="none"
      stroke="currentColor"
      viewBox="0 0 24 24"
    ><path
        stroke-linecap="round"
        stroke-linejoin="round"
        stroke-width="2"
        d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"
      ></path><path
        stroke-linecap="round"
        stroke-linejoin="round"
        stroke-width="2"
        d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"
      ></path></svg>
    <span
      class="text-[10px] font-bold uppercase tracking-widest <%= controller_name == "business_settings" ? "text-indigo-600" : "text-slate-400" %>"
    >Settings</span>
  <% end %>
  <%= button_to session_path,
                method: :delete,
                form: { class: "flex" },
                class: "flex flex-col items-center space-y-1 bg-transparent border-0 p-0 cursor-pointer" do %>
    <svg
      class="w-5 h-5 text-slate-400"
      fill="none"
      stroke="currentColor"
      viewBox="0 0 24 24"
    ><path
        stroke-linecap="round"
        stroke-linejoin="round"
        stroke-width="2"
        d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"
      ></path></svg>
    <span class="text-[10px] font-bold uppercase tracking-widest text-slate-400">Log Out</span>
  <% end %>
</div>
