<div
  class="
    max-w-5xl mx-auto space-y-8 animate-in fade-in slide-in-from-bottom-4
    duration-500
  "
>
  <%# ======== Action Bar ======== %>
  <div
    class="
      flex flex-col md:flex-row md:items-center justify-between gap-6 pb-6 border-b
      border-slate-200
    "
  >
    <div class="flex items-center space-x-4">
      <%= link_to invoices_path, class: "p-2.5 text-slate-400 hover:text-[#00a1de] hover:bg-sky-50 rounded-xl border border-slate-200 transition-all duration-200" do %>
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M10 19l-7-7m0 0l7-7m-7 7h18"
          ></path></svg>
      <% end %>
      <div>
        <div class="flex items-center space-x-3">
          <h1 class="text-2xl font-black text-slate-900 tracking-tight"><%= @invoice.invoice_number %></h1>
          <span
            class="
              inline-flex items-center px-2.5 py-1 rounded-full text-[10px] font-bold border
              <%= @invoice.status_badge_class %> uppercase tracking-widest
            "
          >
            <%= @invoice.status %>
          </span>
        </div>
        <p class="text-sm text-slate-500 mt-1 font-medium"><%= @invoice.client.name %>
          &middot;
          <%= @invoice.invoice_date.strftime("%B %d, %Y") %></p>
      </div>
    </div>

    <div class="flex items-center flex-wrap gap-2">
      <%= link_to edit_invoice_path(@invoice), class: "inline-flex items-center px-4 py-2.5 bg-white border border-slate-200 text-slate-700 text-sm font-bold rounded-xl hover:bg-slate-50 hover:border-slate-300 transition-all shadow-sm" do %>
        <svg
          class="w-4 h-4 mr-2 text-slate-400"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
        ><path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z"
          ></path></svg>
        Edit
      <% end %>

      <%= link_to pdf_invoice_path(@invoice), class: "inline-flex items-center px-4 py-2.5 bg-[#00a1de] text-white text-sm font-bold rounded-xl hover:bg-[#0089bd] transition-all shadow-md shadow-sky-100", target: "_blank" do %>
        <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M7 21h10a2 2 0 002-2V9.414a1 1 0 00-.293-.707l-5.414-5.414A1 1 0 0012.586 3H7a2 2 0 00-2 2v14a2 2 0 002 2z"
          ></path></svg>
        Download PDF
      <% end %>

      <%= link_to invoice_path(@invoice), data: { turbo_method: :delete, turbo_confirm: "Delete this invoice? This action cannot be undone." }, class: "p-2.5 text-slate-400 hover:text-rose-600 hover:bg-rose-50 rounded-xl transition-all" do %>
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"
          ></path></svg>
      <% end %>
    </div>
  </div>

  <%# ======== Invoice Paper (Matches PDF Template) ======== %>
  <div
    class="
      bg-white rounded-xl shadow-xl shadow-slate-200/50 border border-slate-200
      overflow-hidden max-w-[850px] mx-auto p-4 sm:p-8 md:p-16
    "
  >

    <%# ---- Header ---- %>
    <div
      class="
        flex flex-col sm:flex-row justify-between items-start gap-6 border-b-4 border-[#00a1de] pb-8 mb-10
      "
    >
      <div class="space-y-2">
        <h1 class="text-2xl font-black text-[#004a99] tracking-tight uppercase"><%= @business.name %></h1>
        <p class="text-sm text-slate-500 font-medium leading-none"><%= @business.tagline %></p>
        <p class="text-sm text-slate-500 font-medium leading-none mt-1"><%= @business.address %></p>
        <div
          class="
            inline-block px-2 py-1 bg-[#eef7ff] border border-[#00a1de] text-[#004a99]
            text-xs font-bold rounded mt-3
          "
        >
          <%= @business.full_registration %>
        </div>
      </div>

      <div class="text-right">
        <h2 class="text-3xl font-black text-[#00a1de] leading-none mb-2">INVOICE</h2>
        <p class="text-sm text-slate-500 font-mono font-medium"><%= @invoice.invoice_number %></p>
        <p class="text-sm text-slate-500 font-medium mt-1">Data:
          <%= @invoice.invoice_date.strftime("%d/%m/%Y") %></p>
      </div>
    </div>

    <%# ---- Details Grid ---- %>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-12 mb-10">
      <div class="space-y-4">
        <h3
          class="
            text-xs font-bold text-slate-400 uppercase tracking-widest border-b
            border-slate-100 pb-2
          "
        >Cliente / Agência</h3>
        <div class="space-y-1">
          <p class="text-lg font-bold text-slate-900 leading-snug"><%= @invoice.client.name %></p>
          <p class="text-sm text-slate-500 font-medium"><%= @invoice.client.country %></p>
          <% if @invoice.client.phone.present? %>
            <p class="text-xs text-slate-400 font-medium mt-1">Contato:
              <%= @invoice.client.phone %></p>
          <% end %>
        </div>
      </div>

      <% if @invoice.event_type.present? %>
        <div class="space-y-4">
          <h3
            class="
              text-xs font-bold text-slate-400 uppercase tracking-widest border-b
              border-slate-100 pb-2
            "
          ><%= @invoice.event_type %></h3>
          <div class="space-y-1">
            <p class="text-lg font-bold text-slate-900 leading-snug"><%= @invoice.event_location %></p>
            <% if @invoice.event_date.present? %>
              <p class="text-sm text-slate-500 font-medium">Data:
                <%= @invoice.event_date.strftime("%d/%m/%Y") %></p>
            <% end %>
          </div>
        </div>
      <% end %>
    </div>

    <%# ---- Schedule ---- %>
    <% if @invoice.schedule_notes.present? %>
      <div class="bg-[#f0f4f8] border-l-4 border-[#00a1de] rounded-r-lg p-6 mb-10">
        <h3 class="text-xs font-bold text-[#004a99] uppercase tracking-widest mb-3">CRONOGRAMA DO SERVIÇO:</h3>
        <div class="text-sm text-slate-700 leading-relaxed whitespace-pre-line"><%= @invoice.schedule_notes %></div>
      </div>
    <% end %>

    <%# ---- Table (desktop) ---- %>
    <div class="hidden sm:block overflow-x-auto mb-8">
      <table class="rounded-xl w-full text-left border-collapse">
        <thead>
          <tr class="bg-[#004a99] text-white text-xs font-bold uppercase tracking-wider">
            <th class="px-4 py-3 border-r border-[#ffffff22]">Descrição do Serviço</th>
            <th class="px-4 py-3 text-center border-r border-[#ffffff22] w-24">Quantidade</th>
            <th class="px-4 py-3 text-right border-r border-[#ffffff22] w-32">Preço Unit.</th>
            <th class="px-4 py-3 text-right w-32">Subtotal</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-100">
          <% @invoice.line_items.each do |item| %>
            <tr class="hover:bg-slate-50/50 transition-colors">
              <td class="px-4 py-4 text-sm font-medium text-slate-800"><%= item.description %></td>
              <td class="px-4 py-4 text-center text-sm font-mono text-slate-600"><%= item.quantity %></td>
              <td class="px-4 py-4 text-right text-sm font-mono text-slate-600">$ <%= number_with_precision(item.unit_price, precision: 2) %></td>
              <td class="px-4 py-4 text-right text-sm font-mono font-bold text-slate-900">$ <%= number_with_precision(item.subtotal, precision: 2) %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>

    <%# ---- Cards (mobile) ---- %>
    <div class="sm:hidden space-y-2 mb-8">
      <div class="grid grid-cols-3 text-[10px] font-bold uppercase tracking-widest text-slate-400 px-1 pb-1 border-b border-slate-100">
        <span>Descrição</span>
        <span class="text-center">Qtd × Preço</span>
        <span class="text-right">Subtotal</span>
      </div>
      <% @invoice.line_items.each do |item| %>
        <div class="grid grid-cols-3 items-center gap-2 px-1 py-3 border-b border-slate-100 last:border-0">
          <p class="text-sm font-medium text-slate-800 leading-snug"><%= item.description %></p>
          <p class="text-center text-xs font-mono text-slate-500">
            <%= item.quantity %> × $<%= number_with_precision(item.unit_price, precision: 2) %>
          </p>
          <p class="text-right text-sm font-mono font-bold text-slate-900">
            $<%= number_with_precision(item.subtotal, precision: 2) %>
          </p>
        </div>
      <% end %>
    </div>

    <%# ---- Totals ---- %>
    <div class="flex justify-end mb-12">
      <div class="w-full md:w-64 space-y-2 text-right">
        <div class="flex justify-between items-center text-sm">
          <span class="font-medium text-slate-500">Subtotal:</span>
          <span class="font-mono font-bold text-slate-700">$
            <%= number_with_precision(@invoice.subtotal, precision: 2) %></span>
        </div>
        <div class="flex justify-between items-center text-sm">
          <span class="font-medium text-slate-500"><%= @invoice.tax_label %>:</span>
          <span class="font-mono font-bold text-slate-700">$
            <%= number_with_precision(@invoice.tax_amount, precision: 2) %></span>
        </div>
        <div
          class="
            pt-3 border-t-2 border-[#004a99] flex justify-between items-baseline mt-2
          "
        >
          <span class="font-bold text-[#004a99] text-lg uppercase">Total:</span>
          <span class="text-2xl font-mono font-black text-[#004a99]">
            <%= @business.currency %>
            $
            <%= number_with_precision(@invoice.total, precision: 2) %>
          </span>
        </div>
      </div>
    </div>

    <%# ---- Footer ---- %>
    <div class="pt-10 border-t border-slate-100 text-center space-y-2">
      <p class="text-[10px] text-slate-400 font-medium">
        <%= @business.name %>
        &bull;
        <%= @business.address %>
        &bull;
        <%= @business.full_registration %>
      </p>
      <p class="text-[10px] text-slate-400 font-medium">
        Payment Terms: Net
        <%= @business.payment_terms_days %>
        &bull; All prices in
        <%= @business.currency %>
        unless otherwise specified.
      </p>
    </div>
  </div>
</div>
