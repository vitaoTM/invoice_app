<div class="space-y-8">
  <header
    class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4"
  >
    <div>
      <h1 class="text-2xl font-bold text-slate-900 tracking-tight">Invoices</h1>
      <p class="text-sm text-slate-500 mt-1">Manage and track your business billing.</p>
    </div>

    <%= link_to new_invoice_path, class: "inline-flex items-center px-4 py-2.5 bg-indigo-600 hover:bg-indigo-700 text-white text-sm font-semibold rounded-lg shadow-sm transition-colors duration-200 group" do %>
      <span class="text-lg mr-2 transition group-hover:rotate-90">+</span>
      New Invoice
    <% end %>
  </header>

  <div
    class="
      bg-white rounded-xl shadow-sm border border-slate-200 overflow-hidden
    "
  >
    <div
      class="
        border-b border-slate-100 px-4 sm:px-6 py-4 flex flex-col sm:flex-row
        sm:items-center justify-between gap-4
      "
    >
      <nav class="flex space-x-1 bg-slate-100 p-1 rounded-lg overflow-x-auto no-scrollbar whitespace-nowrap">
        <% ["all", "draft", "sent", "paid", "cancelled"].each do |status| %>
          <% active = (params[:status] || "all") == status %>
          <%= link_to status.capitalize,
          status == "all" ? invoices_path : invoices_path(status: status),
          class:
            "px-4 py-1.5 text-xs font-medium rounded-md transition-all duration-200 #{active ? "bg-white text-slate-900 shadow-sm" : "text-slate-500 hover:text-slate-700 hover:bg-slate-50"}" %>
        <% end %>
      </nav>

      <div class="text-xs text-slate-400 font-medium hidden sm:block">
        Showing
        <%= pluralize(@invoices.count, "invoice") %>
      </div>
    </div>

    <div class="overflow-x-auto">
      <table class="w-full text-left min-w-[600px] sm:min-w-0">
        <thead>
          <tr
            class="
              bg-slate-50/50 text-slate-500 text-[11px] font-bold uppercase tracking-wider
              border-b border-slate-100
            "
          >
            <th class="px-6 py-4">Number</th>
            <th class="px-6 py-4">Client</th>
            <th class="px-6 py-4 hidden sm:table-cell">Date</th>
            <th class="px-6 py-4">Status</th>
            <th class="px-6 py-4 text-right">Total</th>
            <th class="px-6 py-4"></th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-100">
          <% if @invoices.any? %>
            <% @invoices.each do |invoice| %>
              <tr class="group hover:bg-slate-50/50 transition-colors duration-200">
                <td class="px-6 py-4">
                  <%= link_to invoice, class: "font-mono text-sm font-medium text-indigo-600 hover:text-indigo-800" do %>
                    <%= invoice.invoice_number %>
                  <% end %>
                </td>
                <td class="px-6 py-4">
                  <div class="flex flex-col">
                    <span class="text-sm font-semibold text-slate-900"><%= invoice.client.name %></span>
                    <span class="text-[11px] text-slate-500 hidden sm:block"><%= invoice.client.country %></span>
                  </div>
                </td>
                <td class="px-6 py-4 hidden sm:table-cell">
                  <span class="text-sm text-slate-600"><%= invoice.invoice_date.strftime("%b %d, %Y") %></span>
                </td>
                <td class="px-6 py-4">
                  <span
                    class="
                      inline-flex items-center px-2.5 py-1 rounded-full text-[11px] font-bold border
                      <%= invoice.status_badge_class %> uppercase tracking-wide
                    "
                  >
                    <%= invoice.status %>
                  </span>
                </td>
                <td class="px-6 py-4 text-right">
                  <span class="text-sm font-mono font-bold text-slate-900">
                    <%= number_to_currency(invoice.total, unit: current_business.currency + " $") %>
                  </span>
                </td>
                <td class="px-6 py-4 text-right">
                  <div
                    class="
                      flex items-center justify-end space-x-2 opacity-100 sm:opacity-0
                      group-hover:opacity-100 transition-opacity
                    "
                  >
                    <%= link_to edit_invoice_path(invoice), class: "p-2 text-slate-400 hover:text-indigo-600 hover:bg-indigo-50 rounded-lg transition-colors", title: "Edit" do %>
                      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z"></path></svg>
                    <% end %>
                    <%= link_to pdf_invoice_path(invoice), class: "p-2 text-slate-400 hover:text-blue-600 hover:bg-blue-50 rounded-lg transition-colors", title: "PDF" do %>
                      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 21h10a2 2 0 002-2V9.414a1 1 0 00-.293-.707l-5.414-5.414A1 1 0 0012.586 3H7a2 2 0 00-2 2v14a2 2 0 002 2z"></path></svg>
                    <% end %>
                  </div>
                </td>
              </tr>
            <% end %>
          <% else %>
            <tr>
              <td colspan="6" class="px-6 py-12 text-center">
                <div class="flex flex-col items-center">
                  <div
                    class="
                      w-12 h-12 bg-slate-50 text-slate-300 rounded-full flex items-center
                      justify-center mb-4
                    "
                  >
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"
                      ></path></svg>
                  </div>
                  <h3 class="text-sm font-semibold text-slate-900">No invoices found</h3>
                  <p class="text-xs text-slate-500 mt-1">Start by creating your first invoice.</p>
                  <%= link_to "New Invoice",
                  new_invoice_path,
                  class: "mt-4 text-sm font-semibold text-indigo-600 hover:text-indigo-700" %>
                </div>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
</div>
