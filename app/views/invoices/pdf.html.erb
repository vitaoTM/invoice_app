<div class="invoice-box">
  <div class="header">
    <div class="company-info">
      <h1><%= business.name %></h1>
      <p><%= business.tagline %></p>
      <p><%= business.address %></p>
      <div class="badge-kvk"><%= business.full_registration %></div>
    </div>
    <div style="text-align: right;">
      <h2 style="margin:0; color: #00a1de; font-size: 28px;">INVOICE</h2>
      <p style="margin: 4px 0 0; color: #666; font-size: 13px;">Data:
        <%= invoice.invoice_date.strftime("%d/%m/%Y") %></p>
      <p
        style="margin: 2px 0 0; color: #999; font-size: 12px; font-family: monospace;"
      ><%= invoice.invoice_number %></p>
    </div>
  </div>

  <div class="details-grid">
    <div>
      <h3>Cliente / Agência</h3>
      <strong><%= invoice.client.name %></strong><br>
      <%= invoice.client.country %><br>
      <% if invoice.client.phone.present? %>
        Contato:
        <%= invoice.client.phone %>
      <% end %>
    </div>
    <div>
      <% if invoice.event_type.present? %>
        <h3><%= invoice.event_type %></h3>
        <strong><%= invoice.event_location %></strong><br>
        <% if invoice.event_date.present? %>
          Data:
          <%= invoice.event_date.strftime("%d/%m/%Y") %><br>
        <% end %>
      <% end %>
    </div>
  </div>

  <% if invoice.schedule_notes.present? %>
    <div class="itinerary-box">
      <strong>CRONOGRAMA DO SERVIÇO:</strong><br>
      <%= simple_format(invoice.schedule_notes) %>
    </div>
  <% end %>

  <table>
    <thead>
      <tr>
        <th>Descrição do Serviço</th>
        <th style="text-align: center;">Quantidade</th>
        <th style="text-align: right;">Preço Unit.</th>
        <th style="text-align: right;">Subtotal</th>
      </tr>
    </thead>
    <tbody>
      <% invoice.line_items.each do |item| %>
        <tr>
          <td><%= item.description %></td>
          <td style="text-align: center;"><%= item.quantity %></td>
          <td style="text-align: right;">$
            <%= number_with_precision(item.unit_price, precision: 2) %></td>
          <td style="text-align: right;">$
            <%= number_with_precision(item.subtotal, precision: 2) %></td>
        </tr>
      <% end %>
    </tbody>
  </table>

  <div class="totals">
    <p>Subtotal: $
      <%= number_with_precision(invoice.subtotal, precision: 2) %></p>
    <p><%= invoice.tax_label %>: $
      <%= number_with_precision(invoice.tax_amount, precision: 2) %></p>
    <p class="grand-total">Total:
      <%= business.currency %>
      $
      <%= number_with_precision(invoice.total, precision: 2) %></p>
  </div>

  <div class="footer">
    <p><%= business.name %>
      —
      <%= business.address %>
      <%= business.full_registration %></p>
    <p>Payment Terms: Net
      <%= business.payment_terms_days %>. All prices in
      <%= business.currency %>
      unless otherwise specified.</p>
  </div>
</div>
