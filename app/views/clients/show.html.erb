<div class="max-w-5xl mx-auto space-y-8 animate-in fade-in slide-in-from-bottom-4 duration-500">
  <%# ======== Action Bar ======== %>
  <div class="flex flex-col md:flex-row md:items-center justify-between gap-6 pb-6 border-b border-slate-200">
    <div class="flex items-center space-x-4">
      <%= link_to clients_path, class: "p-2.5 text-slate-400 hover:text-indigo-600 hover:bg-indigo-50 rounded-xl border border-slate-200 transition-all duration-200" do %>
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path></svg>
      <% end %>
      <div>
        <h1 class="text-2xl font-black text-slate-900 tracking-tight"><%= @client.name %></h1>
        <p class="text-sm text-slate-500 mt-1 font-medium"><%= @client.country %> &middot; Client Profile</p>
      </div>
    </div>

    <div class="flex items-center space-x-3">
      <%= link_to new_invoice_path(client_id: @client.id), class: "inline-flex items-center px-4 py-2.5 bg-indigo-600 text-white text-sm font-bold rounded-xl hover:bg-indigo-700 transition-all shadow-md shadow-indigo-100" do %>
        <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path></svg>
        New Invoice
      <% end %>

      <%= link_to edit_client_path(@client), class: "inline-flex items-center px-4 py-2.5 bg-white border border-slate-200 text-slate-700 text-sm font-bold rounded-xl hover:bg-slate-50 hover:border-slate-300 transition-all shadow-sm" do %>
        <svg class="w-4 h-4 mr-2 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z"></path></svg>
        Edit Client
      <% end %>
      
      <%= link_to client_path(@client), data: { turbo_method: :delete, turbo_confirm: "Delete this client and all records? This action cannot be undone." }, class: "p-2.5 text-slate-400 hover:text-rose-600 hover:bg-rose-50 rounded-xl transition-all" do %>
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path></svg>
      <% end %>
    </div>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
    <%# ---- Client Details Card ---- %>
    <div class="lg:col-span-1 space-y-8">
      <div class="bg-white rounded-3xl shadow-sm border border-slate-200 overflow-hidden">
        <div class="p-8 bg-slate-50/50 border-b border-slate-100 flex flex-col items-center text-center">
          <div class="w-20 h-20 bg-indigo-600 text-white rounded-3xl flex items-center justify-center text-3xl font-black mb-4 shadow-lg shadow-indigo-200">
            <%= @client.name[0..1].upcase %>
          </div>
          <h2 class="text-xl font-black text-slate-900 tracking-tight"><%= @client.name %></h2>
          <p class="text-xs font-bold text-indigo-600 uppercase tracking-widest mt-1"><%= @client.country %></p>
        </div>
        
        <div class="p-8 space-y-6">
          <div class="space-y-4">
            <h3 class="text-[10px] font-bold text-slate-400 uppercase tracking-widest border-b border-slate-50 pb-2">Contact Info</h3>
            <div class="space-y-3">
              <div class="flex items-center text-sm">
                <div class="w-8 h-8 rounded-lg bg-slate-50 flex items-center justify-center mr-3 text-slate-400">
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path></svg>
                </div>
                <span class="text-slate-700 font-medium"><%= @client.phone.presence || "No phone added" %></span>
              </div>
              <div class="flex items-center text-sm">
                <div class="w-8 h-8 rounded-lg bg-slate-50 flex items-center justify-center mr-3 text-slate-400">
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path></svg>
                </div>
                <span class="text-indigo-600 font-bold truncate"><%= @client.email.presence || "No email added" %></span>
              </div>
            </div>
          </div>

          <% if @client.notes.present? %>
            <div class="space-y-4">
              <h3 class="text-[10px] font-bold text-slate-400 uppercase tracking-widest border-b border-slate-50 pb-2">Internal Notes</h3>
              <p class="text-sm text-slate-600 leading-relaxed italic"><%= @client.notes %></p>
            </div>
          <% end %>
        </div>
      </div>
    </div>

    <%# ---- Invoices History ---- %>
    <div class="lg:col-span-2 space-y-6">
      <div class="bg-white rounded-3xl shadow-sm border border-slate-200 overflow-hidden">
        <div class="p-8 border-b border-slate-100 flex items-center justify-between">
          <h2 class="text-lg font-bold text-slate-900 flex items-center">
            <svg class="w-5 h-5 mr-3 text-indigo-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path></svg>
            Invoice History
            <%= link_to "Create New", new_invoice_path(client_id: @client.id), class: "ml-4 text-xs font-bold text-indigo-600 hover:text-indigo-700 bg-indigo-50 px-2 py-1 rounded-lg uppercase tracking-wider transition-colors" %>
          </h2>
          <span class="inline-flex items-center px-3 py-1 bg-indigo-50 text-indigo-700 text-[10px] font-bold rounded-lg uppercase tracking-wider">
            <%= pluralize(@invoices.count, 'Record') %>
          </span>
        </div>

        <div class="overflow-x-auto">
          <table class="w-full text-left">
            <thead>
              <tr class="bg-slate-50 text-[10px] font-bold text-slate-400 uppercase tracking-widest border-b border-slate-100">
                <th class="px-8 py-4">Number</th>
                <th class="px-8 py-4">Date</th>
                <th class="px-8 py-4">Status</th>
                <th class="px-8 py-4 text-right">Total</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-slate-100">
              <% if @invoices.any? %>
                <% @invoices.each do |invoice| %>
                  <tr class="group hover:bg-slate-50/50 transition-colors cursor-pointer" onclick="window.location='<%= invoice_path(invoice) %>'">
                    <td class="px-8 py-5">
                      <%= link_to invoice.invoice_number, invoice, class: "font-mono text-sm font-bold text-indigo-600 hover:underline" %>
                    </td>
                    <td class="px-8 py-5 text-sm text-slate-500 font-medium">
                      <%= invoice.invoice_date.strftime("%b %d, %Y") %>
                    </td>
                    <td class="px-8 py-5">
                      <span class="inline-flex items-center px-2.5 py-1 rounded-full text-[10px] font-bold border <%= invoice.status_badge_class %> uppercase tracking-widest">
                        <%= invoice.status %>
                      </span>
                    </td>
                    <td class="px-8 py-5 text-right font-mono font-bold text-slate-900">
                      <%= number_to_currency(invoice.total, unit: "$") %>
                    </td>
                  </tr>
                <% end %>
              <% else %>
                <tr>
                  <td colspan="4" class="px-8 py-12 text-center text-slate-400 text-sm italic">
                    No invoices found for this client.
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>
</div>
