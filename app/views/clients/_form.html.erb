<%= form_with(model: client, class: "space-y-8 animate-in fade-in slide-in-from-bottom-4 duration-500") do |f| %>
  <% if client.errors.any? %>
    <div class=" bg-rose-50 border border-rose-200 text-rose-800 px-6 py-4 rounded-xl " >
      <h2 class="text-sm font-bold uppercase tracking-wide mb-2"><%= pluralize(client.errors.count, "error") %>
        prevented this client from being saved:</h2>
      <ul class="list-disc list-inside text-sm space-y-1">
        <% client.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div
    class="
      bg-white rounded-2xl shadow-sm border border-slate-200 overflow-hidden
    "
  >
    <div
      class="
        p-4 sm:p-8 border-b border-slate-100 flex items-center space-x-4 bg-slate-50/50
      "
    >
      <div
        class="
          w-10 h-10 bg-indigo-50 text-indigo-600 rounded-xl flex items-center
          justify-center
        "
      >
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"
          ></path></svg>
      </div>
      <div>
        <h2 class="text-lg font-bold text-slate-900">Client Profile</h2>
        <p class="text-xs text-slate-500 font-medium">Basic information and contact details.</p>
      </div>
    </div>

    <div class="p-4 sm:p-8 space-y-6">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <div class="space-y-2">
          <%= f.label :name,
                  class:
                    "block text-[11px] font-bold text-slate-500 uppercase tracking-widest" %>
          <%= f.text_field :name,
                       required: true,
                       placeholder: "e.g. Acme Corp or John Doe",
                       class:
                         "px-2 py-2 block w-full rounded-xl border-slate-200 text-slate-700 focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm shadow-sm placeholder:text-slate-300" %>
        </div>

        <div class="space-y-2">
          <%= f.label :country,
                  class:
                    "block text-[11px] font-bold text-slate-500 uppercase tracking-widest" %>
          <%= f.text_field :country,
                       placeholder: "e.g. Brasil, USA",
                       class:
                         "px-2 py-2 block w-full rounded-xl border-slate-200 text-slate-700 focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm shadow-sm placeholder:text-slate-300" %>
        </div>

        <div class="space-y-2">
          <%= f.label :phone,
                  class:
                    "block text-[11px] font-bold text-slate-500 uppercase tracking-widest" %>
          <%= f.text_field :phone,
                       placeholder: "+55 11 9999-9999",
                       class:
                         "px-2 py-2 block w-full rounded-xl border-slate-200 text-slate-700 focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm shadow-sm placeholder:text-slate-300" %>
        </div>

        <div class="space-y-2">
          <%= f.label :email,
                  class:
                    "block text-[11px] font-bold text-slate-500 uppercase tracking-widest" %>
          <%= f.email_field :email,
                        placeholder: "client@example.com",
                        class:
                          "px-2 py-2 block w-full rounded-xl border-slate-200 text-slate-700 focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm shadow-sm placeholder:text-slate-300" %>
        </div>
      </div>

      <div class="space-y-2">
        <%= f.label :notes,
                class:
                  "block text-[11px] font-bold text-slate-500 uppercase tracking-widest" %>
        <%= f.text_area :notes,
                    rows: 4,
                    placeholder:
                      "Add any specific notes or details about this client...",
                    class:
                      "px-2 py-2 block w-full rounded-xl border-slate-200 text-slate-700 focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm shadow-sm placeholder:text-slate-300" %>
      </div>
    </div>
  </div>

  <div class="flex items-center justify-end space-x-4 pt-4">
    <% if local_assigns[:inline_cancel] %>
      <button type="button"
              data-action="removals#clear"
              class="text-sm font-bold text-slate-500 hover:text-slate-800 transition-colors">
        Cancel
      </button>
    <% else %>
      <%= link_to "Cancel", clients_path,
            class: "text-sm font-bold text-slate-500 hover:text-slate-800 transition-colors" %>
    <% end %>
    <%= f.submit class: "px-8 py-3 bg-indigo-600 hover:bg-indigo-700 text-white font-bold rounded-xl shadow-lg shadow-indigo-100 transition-all duration-200 cursor-pointer" %>
  </div>
<% end %>
