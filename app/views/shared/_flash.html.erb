<% flash.each do |flash_type, message| %>
  <%
    classes = case flash_type.to_sym
    when :notice then "bg-emerald-50 border-emerald-200 text-emerald-800"
    when :alert  then "bg-rose-50 border-rose-200 text-rose-800"
    else              "bg-blue-50 border-blue-200 text-blue-800"
    end
  %>
  <div
    class="container mx-auto px-4 sm:px-6 mt-3"
    data-controller="flash"
  >
    <div class="flex items-center justify-between rounded-lg border px-4 py-3 text-sm font-medium <%= classes %>">
      <span><%= message %></span>
      <button
        type="button"
        class="ml-4 opacity-60 hover:opacity-100 transition-opacity"
        data-action="flash#close"
        aria-label="Dismiss"
      >
        &#x2715;
      </button>
    </div>
  </div>
<% end %>
