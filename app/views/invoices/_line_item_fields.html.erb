<tr class="line-item-row group" data-line-items-target="row">
  <%= f.hidden_field :_destroy, data: { line_items_target: "destroyField" } %>

  <td class="px-8 py-4">
    <%= f.text_field :description,
                 placeholder: "e.g. Photography Service",
                 class:
                   "px-2 py-2 block w-full rounded-lg border-transparent hover:border-slate-200 focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm transition-all" %>
  </td>

  <td class="px-4 py-4 text-center">
    <%= f.number_field :quantity,
                   min: 1,
                   class:
                     "px-2 py-2 block w-16 mx-auto rounded-lg border-transparent hover:border-slate-200 focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm text-center font-mono transition-all",
                   data: {
                     action: "input->line-items#recalculate",
                   } %>
  </td>

  <td class="px-4 py-4 text-right">
    <div class="relative">
      <div
        class="
          absolute inset-y-0 left-0 pl-2 flex items-center pointer-events-none
          text-slate-400 text-xs
        "
      >$</div>
      <%= f.number_field :unit_price,
                     step: 0.01,
                     min: 0,
                     class:
                       "px-2 py-2 block w-28 ml-auto pl-6 rounded-lg border-transparent hover:border-slate-200 focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm text-right font-mono transition-all",
                     data: {
                       action: "input->line-items#recalculate",
                     } %>
    </div>
  </td>

  <td class="px-4 py-4 text-right">
    <span
      class="text-sm font-mono font-bold text-slate-900"
      data-line-items-target="rowSubtotal"
    >
      <%= number_to_currency(f.object.subtotal || 0, unit: "$") %>
    </span>
  </td>

  <td class="px-8 py-4 text-right">
    <button
      type="button"
      data-action="line-items#remove"
      class="
        p-2 text-slate-300 hover:text-rose-600 hover:bg-rose-50 rounded-lg
        transition-colors duration-200
      "
      title="Remove item"
    >
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          d="M6 18L18 6M6 6l12 12"
        ></path>
      </svg>
    </button>
  </td>
</tr>
