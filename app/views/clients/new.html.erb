<%# if request.headers["Turbo-Frame"] == "new_client_inline" %>
  <%= turbo_frame_tag "new_client_inline" do %>
    <div class="bg-white rounded-2xl border border-slate-200 p-6 mt-2">
      <h3 class="text-sm font-bold text-slate-700 mb-4">New Client</h3>
      <%= render "form", client: @client %>
    </div>
  <% end %>
<%# else %>
  <div class="max-w-2xl mx-auto space-y-8 animate-in fade-in slide-in-from-bottom-4 duration-500 mb-5 mt-5">
    <header class="flex flex-col md:flex-row md:items-center space-x-0 md:space-x-6 space-y-4 md:space-y-0 pb-6 border-b border-slate-200">
      <%= link_to clients_path, class: "w-10 h-10 p-2.5 text-slate-400 hover:text-indigo-600 hover:bg-indigo-50 rounded-xl border border-slate-200 transition-all duration-200 inline-flex items-center justify-center shadow-sm" do %>
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path></svg>
      <% end %>

      <div>
        <h1 class="text-2xl font-black text-slate-900 tracking-tight">New Client</h1>
        <p class="text-sm text-slate-500 mt-1 font-medium">Add a new client to your records.</p>
      </div>
    </header>

    <%= turbo_frame_tag @client do %>
      <%= render "form", client: @client %>
    <% end %>
  </div>
<%# end %>
